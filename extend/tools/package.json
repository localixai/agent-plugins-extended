{
  "name": "agent-plugins-extended-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run check:upstream && bun run check:links && bun run check:sections && bun run coverage --check && bun run verification --check && bun run judgments --check && bun run implementations --check",
    "check:upstream": "bun src/check-upstream.ts",
    "coverage": "bun src/coverage.ts",
    "check:links": "bun src/check-links.ts",
    "check:sections": "bun src/check-sections.ts",
    "corpus": "bun src/corpus/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "verification": "bun src/verification.ts",
    "judgments": "bun src/judgments-index.ts",
    "implementations": "bun src/implementations.ts",
    "docs:pull": "bun src/mine/docs/pull.ts",
    "types:pull": "bun src/mine/docs/pull-types.ts",
    "types:extract": "bun src/mine/declarations/write.ts",
    "spec:extract": "bun src/mine/requirements/extract.ts",
    "corpus:fetch": "bun src/mine/corpus/fetch.ts",
    "corpus:oracle": "bun src/mine/corpus/run-oracle.ts",
    "oracle:record": "bun src/mine/oracle/main.ts",
    "mine": "bun src/mine/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "ajv": "8.17.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
