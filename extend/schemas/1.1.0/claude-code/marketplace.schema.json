{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localix.ai/schemas/agent-plugins-extended/1.1.0/claude-code/marketplace.schema.json",
  "title": "Claude Code marketplace catalog",
  "description": "A marketplace's .claude-plugin/marketplace.json as Claude Code 2.1.330 accepts it (Agent Plugins Extended 1.1.0, chapter 15). An unknown key at the top level, in metadata, in an entry, or under an entry's relevance is ignored and accepted here (section 15.1 item 5).",
  "$comment": "Not expressed here: the reserved and impersonating names of section 15.3.2, duplicate entry names, renames chains, and the checks of each relative-path entry's own plugin.json, which plugin.schema.json covers.",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "allOf": [{ "$ref": "#/$defs/idPart" }, { "not": { "pattern": "\\.\\." } }],
      "description": "The marketplace identifier (section 15.3.1)."
    },
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "plugins": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "metadata": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "version": { "type": "string" },
        "pluginRoot": { "type": "string" }
      }
    },
    "forceRemoveDeletedPlugins": { "type": "boolean" },
    "allowCrossMarketplaceDependenciesOn": { "type": "array", "items": { "type": "string" } },
    "renames": {
      "type": "object",
      "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/idPart" }, { "type": "null" }] }
    }
  },
  "if": {
    "not": { "required": ["metadata"], "properties": { "metadata": { "required": ["pluginRoot"] } } }
  },
  "then": {
    "properties": {
      "plugins": {
        "items": {
          "properties": {
            "source": { "anyOf": [{ "type": "object" }, { "$ref": "#/$defs/relativePath" }] }
          }
        }
      }
    },
    "description": "Without metadata.pluginRoot, a string source must start with ./ (section 15.6.2)."
  },
  "$defs": {
    "idPart": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Letters a-z and A-Z, digits, \".\", \"_\" and \"-\", starting with a letter or digit (section 15.3.1)."
    },
    "noDotDot": { "not": { "pattern": "(^|[/\\\\])\\.\\.([/\\\\]|$)" } },
    "relativePath": {
      "type": "string",
      "anyOf": [{ "const": "." }, { "pattern": "^\\./" }],
      "allOf": [{ "$ref": "#/$defs/noDotDot" }]
    },
    "stringSource": {
      "type": "string",
      "anyOf": [{ "const": "." }, { "pattern": "^\\./" }, { "pattern": "^[^/\\\\]+$" }],
      "allOf": [{ "$ref": "#/$defs/noDotDot" }],
      "description": "A path from the marketplace root starting with ./, \".\", or a bare name under metadata.pluginRoot (sections 15.6.1 and 15.6.2)."
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "objectSource": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "enum": ["github", "url", "git-subdir", "npm", "archive", "command"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "github" } } },
          "then": {
            "required": ["repo"],
            "properties": { "repo": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 }, "sha": { "$ref": "#/$defs/sha" } }
          }
        },
        {
          "if": { "properties": { "source": { "const": "url" } } },
          "then": {
            "required": ["url"],
            "properties": { "url": { "type": "string", "minLength": 1 }, "ref": { "type": "string", "minLength": 1 }, "sha": { "$ref": "#/$defs/sha" } }
          }
        },
        {
          "if": { "properties": { "source": { "const": "git-subdir" } } },
          "then": {
            "required": ["url", "path"],
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "ref": { "type": "string", "minLength": 1 },
              "sha": { "$ref": "#/$defs/sha" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "npm" } } },
          "then": {
            "required": ["package"],
            "properties": {
              "package": { "type": "string", "minLength": 1, "not": { "pattern": "\\.\\." } },
              "version": { "type": "string" },
              "registry": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "archive" } } },
          "then": {
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "command" } } },
          "then": {
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[\\x20-\\x7E]+$", "not": { "pattern": " {4}" } },
              "timeout": { "type": "integer", "minimum": 1, "maximum": 600 },
              "mode": { "enum": ["copy", "link"] }
            }
          }
        }
      ]
    },
    "limited": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relevance": {
      "if": { "type": "object" },
      "then": {
        "properties": {
          "topic": { "type": "string", "maxLength": 64 },
          "signals": {
            "type": "object",
            "properties": {
              "cwd": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 256 } },
              "cli": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 64 } },
              "hosts": {
                "type": "array",
                "maxItems": 20,
                "items": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9.-]+$" }
              },
              "filesRead": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 256 } },
              "manifestDeps": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "required": ["file", "pattern"],
                  "properties": {
                    "file": { "type": "string", "maxLength": 256 },
                    "pattern": { "type": "string", "maxLength": 256 }
                  }
                }
              }
            }
          }
        }
      },
      "description": "A relevance that is not an object is ignored with a warning; a value over its limit invalidates the entry (section 15.9.1)."
    },
    "entry": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "$ref": "#/$defs/idPart" },
        "source": { "anyOf": [{ "$ref": "#/$defs/stringSource" }, { "$ref": "#/$defs/objectSource" }] },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "strict": { "type": "boolean" },
        "relevance": { "$ref": "#/$defs/relevance" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "headersHelper": { "type": "string" },
        "metadata": { "description": "The author's own object; another value is ignored with a warning (section 15.4)." },
        "experimental": {
          "if": { "type": "object" },
          "then": { "$ref": "plugin.schema.json#/$defs/experimental" },
          "description": "A value that is not an object is ignored with a warning (section 15.4)."
        },
        "$schema": { "type": "string" },
        "displayName": { "type": "string" },
        "engines": {
          "$ref": "plugin.schema.json#/properties/engines",
          "description": "As in plugin.json: a malformed value is ignored at load with a validator warning or error at plugins[<i>].engines (section 15.4, section 2.4)."
        },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "author": { "$ref": "plugin.schema.json#/$defs/person" },
        "homepage": { "$ref": "plugin.schema.json#/$defs/url" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "defaultEnabled": { "type": "boolean" },
        "dependencies": { "type": "array", "items": { "$ref": "plugin.schema.json#/$defs/dependency" } },
        "settings": { "type": "object" },
        "userConfig": { "$ref": "plugin.schema.json#/$defs/userConfig" },
        "types": { "$ref": "plugin.schema.json#/properties/types" },
        "channels": { "type": "array", "items": { "$ref": "plugin.schema.json#/$defs/channel" } },
        "skills": { "$ref": "plugin.schema.json#/$defs/skillsPaths" },
        "commands": { "$ref": "plugin.schema.json#/$defs/commands" },
        "agents": { "$ref": "plugin.schema.json#/$defs/agentPaths" },
        "hooks": { "$ref": "plugin.schema.json#/$defs/hooks" },
        "mcpServers": { "$ref": "plugin.schema.json#/$defs/mcpServers" },
        "lspServers": { "$ref": "plugin.schema.json#/$defs/lspServers" },
        "outputStyles": { "$ref": "plugin.schema.json#/$defs/paths" },
        "workflows": { "$ref": "plugin.schema.json#/$defs/paths" },
        "themes": { "$ref": "plugin.schema.json#/$defs/paths" },
        "monitors": { "$ref": "plugin.schema.json#/$defs/monitors" }
      },
      "if": { "required": ["headersHelper"] },
      "then": { "required": ["strict"], "properties": { "strict": { "const": false } } },
      "description": "An entry takes every plugin.json field of section 2.2 but the directory listing fields, which are unknown here (section 15.4). Unlike plugin.json, an entry's malformed display field still refuses the entry: Claude Code 2.1.330 will not install it (This plugin's marketplace entry is invalid; section 15.5.3, Judgment J15.15)."
    }
  }
}
